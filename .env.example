# Copy to .env and adjust. Never commit .env.
# No API keys needed: deploys are either simulated or run locally by the sandbox engine.

# --- Backend (read from the process environment) ---
# Comma-separated origins allowed by CORS (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 1 = use mock agents only (offline). Default: real profiler + strategist
# (needs git and network), mock provisioner + healer.
MOCK_AGENTS=0
# Seconds each mock agent step sleeps; set to 0 for instant runs.
MOCK_AGENT_DELAY=0.6
# How many health checks the mock healer fails before reporting healthy (0-3).
# 1 shows a single repair loop; 4+ exhausts the 3 repair attempts.
MOCK_HEALER_FAILURES=1
# 1 = real healer: HTTPS-probes each deployed URL and diagnoses failures. Off by default
# while the provisioner is mocked, since its made-up URLs would always fail the probe.
REAL_HEALER=0

# --- Sandbox engine: a $0 Vercel/Render on this machine (needs Docker running) ---
# 1 = every agent is real; apps are built in hardened containers and served at
# http://<app>.localhost:<DEPLOYSMITH_ROUTER_PORT>. Overrides REAL_HEALER.
SANDBOX_ENGINE=0
# Where deploys, build logs and the router config live. Default: <repo>/.deploysmith
DEPLOYSMITH_ENGINE_DIR=
# Host port the nginx router is published on (127.0.0.1 only).
DEPLOYSMITH_ROUTER_PORT=8080
# Successful deploys kept per app as rollback targets (server deploys keep their
# dependencies, so each one can take hundreds of MB).
DEPLOYSMITH_KEEP_DEPLOYS=3
# Seconds a new server gets to answer HTTP before the deploy fails.
DEPLOYSMITH_READY_TIMEOUT=60
# Memory limit for each running app container.
DEPLOYSMITH_APP_MEMORY=512m

# --- API protection ---
# Host header allowlist (blocks DNS rebinding). Add your hostname when hosting the backend.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# --- Frontend (Vite loads this file via envDir; only VITE_* vars reach the browser) ---
VITE_API_URL=http://localhost:8000

# --- Dev-only "Add project" editor (frontend/plugins/projectEditor.ts) ---
# Optional GitHub token (no scopes needed for public repos). Raises the API limit from
# 60 to 5,000 requests/hour. Read by the Vite dev server only; never sent to the browser.
GITHUB_TOKEN=
