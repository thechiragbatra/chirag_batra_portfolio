{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deploysmith.dev/schemas/state.schema.json",
  "title": "DeploymentState",
  "description": "Shared state threaded through the LangGraph pipeline and returned in the final `done` event.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "repo_url",
    "repo_profile",
    "deployment_plan",
    "deployment_results",
    "health_report",
    "errors",
    "repair_attempts",
    "agent_status"
  ],
  "properties": {
    "repo_url": { "type": "string", "description": "Normalized https://github.com/<owner>/<repo>." },
    "repo_profile": { "anyOf": [{ "$ref": "#/$defs/RepoProfile" }, { "type": "null" }] },
    "deployment_plan": { "anyOf": [{ "$ref": "#/$defs/DeploymentPlan" }, { "type": "null" }] },
    "deployment_results": { "type": "array", "items": { "$ref": "#/$defs/DeploymentResult" } },
    "health_report": { "anyOf": [{ "$ref": "#/$defs/HealthReport" }, { "type": "null" }] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "repair_attempts": { "type": "integer", "minimum": 0, "maximum": 3 },
    "agent_status": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/AgentName" },
      "additionalProperties": { "$ref": "#/$defs/AgentStatus" }
    }
  },
  "$defs": {
    "AgentName": {
      "type": "string",
      "enum": ["profiler", "strategist", "provisioner", "healer"]
    },
    "AgentStatus": {
      "type": "string",
      "enum": ["idle", "running", "done", "failed"]
    },
    "Platform": {
      "description": "Free-tier hosting targets only, or the local sandbox engine.",
      "type": "string",
      "enum": [
        "vercel",
        "netlify",
        "cloudflare_pages",
        "render",
        "hf_spaces",
        "neon",
        "supabase",
        "turso",
        "sandbox"
      ]
    },
    "Component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "framework", "build_command", "start_command", "port"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["frontend", "backend", "database"] },
        "path": { "type": "string" },
        "framework": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "build_command": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "start_command": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "port": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }
      }
    },
    "RepoProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_branch", "languages", "frameworks", "components", "env_vars"],
      "properties": {
        "name": { "type": "string", "description": "owner/repo" },
        "default_branch": { "type": "string" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "components": { "type": "array", "items": { "$ref": "#/$defs/Component" } },
        "env_vars": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DeploymentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "platform", "reason", "env_vars"],
      "properties": {
        "component": { "type": "string" },
        "platform": { "$ref": "#/$defs/Platform" },
        "reason": { "type": "string" },
        "env_vars": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DeploymentPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets", "notes"],
      "properties": {
        "targets": { "type": "array", "items": { "$ref": "#/$defs/DeploymentTarget" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "DeploymentResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "platform", "status", "url", "attempt"],
      "properties": {
        "component": { "type": "string" },
        "platform": { "$ref": "#/$defs/Platform" },
        "status": { "type": "string", "enum": ["live", "failed"] },
        "url": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "attempt": { "type": "integer", "minimum": 0, "description": "0 = first deploy, n = repair n." }
      }
    },
    "HealthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "url", "ok", "status_code", "latency_ms", "detail"],
      "properties": {
        "component": { "type": "string" },
        "url": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "ok": { "type": "boolean" },
        "status_code": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "latency_ms": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "detail": { "type": "string" }
      }
    },
    "HealthReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthy", "checks", "diagnosis"],
      "properties": {
        "healthy": { "type": "boolean" },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/HealthCheck" } },
        "diagnosis": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    }
  }
}
